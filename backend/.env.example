NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=cu_bus
DB_PASS=cu_bus
DB_NAME=initial
DB_CONNECTION_LIMIT=10
# Prisma uses this URL. It may be omitted by the Node server, which derives it
# from DB_HOST/DB_PORT/DB_USER/DB_PASS/DB_NAME, but keep it set for Prisma CLI.
DATABASE_URL=mysql://cu_bus:cu_bus@127.0.0.1:3307/initial
DATA_DIR=./data
SCHEDULED_JOBS_ENABLED=true
BACKEND_RELEASE_DATE=2026-07-14 00:00:00

ALLOWED_ORIGINS=https://app.cu-bus.online,http://localhost:5173,capacitor://app.cu-bus.online,ionic://app.cu-bus.online,capacitor://cu-bus.online,ionic://cu-bus.online

CUSIS_ENDPOINT=https://campusapps.itsc.cuhk.edu.hk/store/CLASSSCHD/STT.asmx
CUSIS_AES_KEY=replace-with-protocol-key
CUSIS_AES_IV=replace-with-protocol-iv
CUSIS_MAX_FAILURES=6
CUSIS_FAILURE_WINDOW_MS=900000
