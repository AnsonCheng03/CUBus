{
  "expo": {
    "name": "CU Bus",
    "slug": "cu-bus-native",
    "scheme": "cubus",
    "version": "1.0.11",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "icon": "../resources/icon.png",
    "splash": {
      "image": "./src/assets/bus.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.cubus.app",
      "deploymentTarget": "16.4",
      "supportsTablet": true,
      "requireFullScreen": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Display Nearby Bus Stops",
        "NSLocationAlwaysUsageDescription": "Display Nearby Bus Stops",
        "NSLocationWhenInUseUsageDescription": "Display Nearby Bus Stops"
      }
    },
    "android": {
      "package": "com.cubus.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "cu-bus.online",
              "pathPrefix": "/open-app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "../resources/icon.png",
        "backgroundColor": "#d6a16e"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "@sentry/react-native",
        {
          "organization": "ansoncheng",
          "project": "cu-bus",
          "url": "https://sentry.io/"
        }
      ],
      "expo-ios-scene-lifecycle-plugin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
