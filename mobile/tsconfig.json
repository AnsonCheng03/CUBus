{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@core/*": [
        "../src/shared-core/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "expo-env.d.ts",
    "../src/shared-core/**/*.ts",
    "../src/shared-core/**/*.tsx",
    ".expo/types/**/*.ts"
  ]
}
