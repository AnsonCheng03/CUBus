{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "types": [
      "jest"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@core/*": [
        "../src/shared-core/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "expo-env.d.ts",
    "../src/shared-core/**/*.ts",
    "../src/shared-core/**/*.tsx",
    ".expo/types/**/*.ts"
  ],
  "exclude": [
    "e2e",
    "e2e-web"
  ]
}
