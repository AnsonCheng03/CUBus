# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
default.profraw

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Keep the checked-in iOS splash resource used by the native launch screen.
!/ios/
!/ios/CUBus/
ios/CUBus/*
!/ios/CUBus/Images.xcassets/
ios/CUBus/Images.xcassets/*
!/ios/CUBus/Images.xcassets/SplashScreenLogo.imageset/
!/ios/CUBus/Images.xcassets/SplashScreenLogo.imageset/Contents.json
!/ios/CUBus/Images.xcassets/SplashScreenLogo.imageset/SplashScreenLogo.png
