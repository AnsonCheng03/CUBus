{
  "name": "cu-bus-native",
  "private": true,
  "version": "1.0.11",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "postinstall": "patch-package",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns=src/shared-core/__tests__",
    "test:shared-core": "vitest run --config vitest.shared.config.ts",
    "test:e2e:setup": "appium driver install uiautomator2 && appium driver install xcuitest",
    "test:e2e:android": "tsx e2e/run.android.ts",
    "test:e2e:ios": "tsx e2e/run.ios.ts",
    "test:e2e:web": "playwright test --config e2e-web/playwright.config.ts",
    "test:all": "npm run test:unit && npm run test:shared-core && npm run test:e2e:web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.17.0",
    "expo": "~56.0.12",
    "expo-asset": "~56.0.17",
    "expo-constants": "~56.0.18",
    "expo-font": "~56.0.7",
    "expo-linking": "~56.0.14",
    "expo-location": "~56.0.17",
    "expo-router": "~56.2.11",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "i18next": "^26.3.1",
    "intl-pluralrules": "^2.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.8",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@react-native/jest-preset": "^0.85.3",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.3.0",
    "@types/react": "~19.2.2",
    "appium": "^3.0.1",
    "babel-preset-expo": "^56.0.15",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.5",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.2.3",
    "tsx": "^4.20.5",
    "typescript": "~6.0.3",
    "vitest": "^4.1.9",
    "webdriverio": "^9.19.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/e2e/",
      "<rootDir>/e2e-web/"
    ]
  }
}
